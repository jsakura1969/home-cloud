{
  "_説明": "各エージェントの起動条件（フック条件）。ユーザーの依頼文にキーワードが含まれると、そのエージェントを呼ぶよう Claude に指示が入る。teach-agent スキルで編集できる。order は複数該当したときに勧める実行順。",
  "skip_phrases": [
    "エージェントなし",
    "エージェント無し",
    "直接やって",
    "自分でやって",
    "no agent"
  ],
  "min_length": 6,
  "agents": [
    {
      "name": "計画係",
      "order": 1,
      "when": "新しく何かを作る・始める・変える依頼、複数ステップになる依頼、進め方を相談されたとき",
      "keywords": [
        "計画",
        "設計",
        "段取り",
        "進め方",
        "どう進め",
        "方針",
        "手順を",
        "ロードマップ",
        "スケジュール",
        "戦略",
        "企画",
        "構成を考え",
        "作りたい",
        "作って",
        "実装して",
        "追加して",
        "導入して",
        "移行",
        "リファクタ",
        "新機能",
        "仕組みを"
      ],
      "long_request_chars": 250
    },
    {
      "name": "調査係",
      "order": 2,
      "when": "事実・最新情報・比較・原因・コードの所在など、調べないと正確に答えられないとき",
      "keywords": [
        "調べ",
        "調査",
        "リサーチ",
        "比較",
        "違い",
        "最新",
        "とは何",
        "って何",
        "なぜ",
        "原因",
        "おすすめ",
        "選ぶなら",
        "どれがいい",
        "相場",
        "価格",
        "料金",
        "バージョン",
        "仕様",
        "出典",
        "根拠",
        "どこで",
        "どこに",
        "探して",
        "http://",
        "https://"
      ]
    },
    {
      "name": "文章係",
      "order": 3,
      "when": "日本語の文章を作る・直す・まとめる依頼",
      "keywords": [
        "書いて",
        "文章",
        "文面",
        "メール",
        "返信",
        "お知らせ",
        "告知",
        "案内文",
        "挨拶",
        "推敲",
        "添削",
        "言い換え",
        "わかりやすく",
        "分かりやすく",
        "要約",
        "まとめて",
        "下書き",
        "原稿",
        "投稿文",
        "説明文",
        "報告書"
      ]
    },
    {
      "name": "レビュー係",
      "order": 4,
      "when": "成果物の確認を求められたとき、完成・完了を宣言する前、コミット・push・PR の前",
      "keywords": [
        "レビュー",
        "チェック",
        "確認して",
        "見直し",
        "問題ない",
        "大丈夫",
        "合ってる",
        "間違い",
        "できた",
        "完成",
        "完了",
        "仕上げ",
        "コミット",
        "push",
        "プッシュ",
        "PRを",
        "PR作成",
        "プルリク",
        "マージ",
        "リリース",
        "公開して"
      ]
    }
  ],
  "pre_commit_review": {
    "enabled": true,
    "commands_regex": "\\bgit\\s+(commit|push)\\b|\\bgh\\s+pr\\s+create\\b",
    "skip_regex": "teach\\(|--allow-empty"
  }
}
